# ==============================================================================
#  YOURIPLAWYER — environment variables
#  Copy this file to `.env` (local) or add these in your hosting dashboard (Vercel → Settings → Environment Variables).
#  Lines starting with # are comments. Never commit your real .env file.
# ==============================================================================

# ---- Site identity (public) ----------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://youriplawyer.in
NEXT_PUBLIC_CONTACT_EMAIL=hello@youriplawyer.in
# Optional: separate inbox for article submissions (defaults to the contact email)
NEXT_PUBLIC_SUBMISSIONS_EMAIL=
# Optional social links (leave empty to hide)
NEXT_PUBLIC_SOCIAL_LINKEDIN=
NEXT_PUBLIC_SOCIAL_X=
NEXT_PUBLIC_SOCIAL_INSTAGRAM=

# ---- Security (secret) ---------------------------------------------------------
# Random string, at least 32 characters. Generate one with:  openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string

# ---- Database -------------------------------------------------------------------
# Leave DATABASE_URL EMPTY for local development: an embedded Postgres (PGlite) is created in ./.data/pglite automatically.
# In production set it to your PostgreSQL connection string (Neon, Supabase, Railway, etc.).
DATABASE_URL=
# Set to "false" if your database does not use SSL (local Postgres).
DATABASE_SSL=

# ---- File storage (feature images, PDFs) ----------------------------------------
# local        → files saved in ./uploads (fine for a VPS; NOT for Vercel/serverless)
# vercel-blob  → Vercel Blob storage (recommended on Vercel; just add BLOB_READ_WRITE_TOKEN from the Vercel dashboard)
# s3           → any S3-compatible bucket (AWS S3, Cloudflare R2, Supabase Storage, MinIO)
STORAGE_DRIVER=local
BLOB_READ_WRITE_TOKEN=
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public base URL of the bucket (e.g. https://files.youriplawyer.in) — used to build file links
S3_PUBLIC_URL=
# Extra hostnames allowed for next/image (comma separated), if you link images from elsewhere
NEXT_PUBLIC_IMAGE_HOSTS=

# ---- Anti-spam ------------------------------------------------------------------
# Cloudflare Turnstile (free): https://dash.cloudflare.com → Turnstile. Leave both empty to disable the widget.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# auto   → clean comments/threads appear immediately, anything suspicious waits for approval (default)
# manual → EVERYTHING waits for your approval in the admin dashboard
MODERATION_MODE=auto

# ---- Optional analytics ----------------------------------------------------------
# Plausible domain, e.g. youriplawyer.in (leave empty to disable)
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ---- First admin account (used ONLY by `npm run admin:create` when you do not pass flags) ----
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# ---- Advanced (optional; defaults are fine) ---------------------------------------
# Folder for files when STORAGE_DRIVER=local (default ./uploads)
LOCAL_UPLOAD_DIR=
# Folder for the embedded local database (default ./.data/pglite)
PGLITE_DATA_DIR=
# Set to "true" to run pending migrations automatically when a Postgres connection opens (otherwise `npm run db:migrate` / the build does it)
DB_AUTO_MIGRATE=
